<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.realtek.coex</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/rtwcoexd</string>
        <string>-b</string>
        <string>30</string>
        <string>-w</string>
        <string>35</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/rtwcoexd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/rtwcoexd.log</string>
</dict>
</plist>
